{
	"name": "pi-freellmapi",
	"version": "0.1.0",
	"type": "module",
	"description": "Pi extension for discovering models from a FreeLLMAPI gateway",
	"main": "./index.ts",
	"module": "./index.ts",
	"types": "./index.ts",
	"exports": {
		".": {
			"import": "./index.ts",
			"types": "./index.ts"
		}
	},
	"license": "MIT",
	"author": "7thw",
	"repository": {
		"type": "git",
		"url": "https://github.com/7thw/pi-freellmapi.git"
	},
	"bugs": {
		"url": "https://github.com/7thw/pi-freellmapi/issues"
	},
	"homepage": "https://github.com/7thw/pi-freellmapi#readme",
	"keywords": [
		"pi-package",
		"pi-extension",
		"freellmapi",
		"openai-compatible",
		"llm",
		"ai",
		"model-provider"
	],
	"engines": {
		"node": ">=22"
	},
	"files": [
		"index.ts",
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"format": "biome check --write *.ts *.json src test",
		"check": "biome check *.ts *.json src test && tsc --noEmit && vitest run"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@earendil-works/pi-ai": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.8.1/prime-agent-ai-0.8.1.tgz",
		"@earendil-works/pi-coding-agent": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.8.1/prime-agent-0.8.1.tgz",
		"@types/node": "latest",
		"typescript": "latest",
		"vitest": "latest"
	}
}
