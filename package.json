{
	"name": "pi-freellmapi",
	"version": "0.1.0",
	"type": "module",
	"description": "Pi extension for discovering models from a FreeLLMAPI gateway.",
	"keywords": [
		"pi-package",
		"pi",
		"extension",
		"freellmapi"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"index.ts",
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"format": "biome check --write *.ts *.json src",
		"check": "biome check *.ts *.json src && tsc --noEmit"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@earendil-works/pi-ai": "0.84.4",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@types/node": "latest",
		"typescript": "latest",
		"vitest": "latest"
	}
}
