{
	"name": "pi-freellmapi",
	"version": "0.1.5",
	"type": "module",
	"description": "Pi Agent extension for discovering models from a FreeLLMAPI",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"freellmapi",
		"openai-compatible"
	],
	"engines": {
		"node": ">=22"
	},
	"files": [
		"index.ts",
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"format": "biome check --write *.ts *.json src test",
		"check": "biome check *.ts *.json src test && tsc --noEmit && vitest run"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@earendil-works/pi-ai": "^0.80.9",
		"@earendil-works/pi-coding-agent": "^0.80.9",
		"@types/node": "latest",
		"typescript": "latest",
		"vitest": "latest"
	}
}
