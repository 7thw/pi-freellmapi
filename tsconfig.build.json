{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": false,
		"outDir": "./dist",
		"rootDir": ".",
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"include": ["index.ts", "src/**/*.ts", "bin/**/*.ts"],
	"exclude": ["node_modules", "dist", "test"]
}
